[
 {"id":"acceptance-test-driven-development","term":"인수 테스트 주도 개발","term_en":"Acceptance Test-Driven Development (ATDD)","definition":"고객·개발자·테스터가 구현 전에 인수 기준을 자동화된 인수 테스트로 합의하고, 그 테스트를 통과시키는 방향으로 개발하는 기법.","features":["요구사항을 실행 가능한 인수 테스트로 명세","TDD의 외부 사이클 역할, 단위 수준은 TDD로 수행","고객 언어 기반 협업으로 요구 오해 감소","FitNesse·Cucumber 등 도구 활용"],"related":["test-driven-development","behavior-driven-development","agile"]},
 {"id":"affinity-analysis","term":"친화도 분석","term_en":"Affinity Analysis","definition":"프로세스·기능과 데이터 엔티티 간 생성·사용 관계의 밀접도를 분석하여 관련성이 높은 요소를 묶는 기법으로, 컴포넌트·서브시스템 경계 식별에 활용.","features":["CRUD 매트릭스를 기반으로 친화도 산출","생성 책임이 같은 엔티티를 동일 그룹으로 배치","응집도 높은 컴포넌트 후보 도출","정보공학(IE) 방법론에서 유래"],"related":["component-based-development","software-component","cohesion"]},
 {"id":"agile","term":"애자일","term_en":"Agile","definition":"짧은 반복 주기로 동작하는 SW를 점진적으로 전달하고 변화에 유연하게 대응하는 개발 철학으로, 2001년 애자일 선언문의 4가치·12원칙에 기반.","features":["개인과 상호작용, 동작하는 SW, 고객 협력, 변화 대응 중시","스크럼·XP·칸반 등 다양한 방법론 포함","짧은 피드백 루프와 지속적 개선","자기조직화 팀과 지속 가능한 개발 속도"],"related":["scrum","kanban-board","extreme-programming","lean"]},
 {"id":"auto-scaling","term":"오토스케일링","term_en":"Auto Scaling","definition":"부하·지표에 따라 서버·컨테이너 인스턴스 수를 자동으로 증감하여 성능과 비용을 균형 있게 유지하는 클라우드 기능.","features":["CPU·요청 수 등 지표 기반 스케일 아웃·인","수평 확장(인스턴스 수)과 수직 확장(자원 크기)","장애 인스턴스 자동 교체로 가용성 향상","카오스 테스트에서 복구 능력 검증 대상"],"related":["cloud-computing","kubernetes","chaos-engineering"]},
 {"id":"basis-path-testing","term":"기본 경로 테스트","term_en":"Basis Path Testing","definition":"제어 흐름 그래프의 순환 복잡도 V(G)만큼 선형 독립 경로를 도출하고 각 경로를 최소 1회 실행하는 테스트 케이스를 설계하는 화이트박스 기법(McCabe).","features":["독립 경로 수 = V(G) = E-N+2","모든 구문·분기를 최소 1회 실행 보장","경로 폭증을 기본 경로 집합으로 축소","실행 불가 경로 식별 필요"],"related":["control-flow-graph","cyclomatic-complexity","white-box-testing","path-coverage"]},
 {"id":"behavior-driven-development","term":"행위 주도 개발","term_en":"Behavior-Driven Development (BDD)","definition":"Given-When-Then 형식의 자연어 시나리오로 시스템 행위를 명세하고 이를 자동화 테스트로 연결하는 TDD 확장 기법.","features":["비즈니스 관점 유비쿼터스 언어 사용","시나리오가 요구 명세·테스트·문서 역할","Cucumber·SpecFlow·JBehave 도구","TDD·ATDD와 결합하여 바깥에서 안으로 개발"],"related":["test-driven-development","acceptance-test-driven-development","agile"]},
 {"id":"beta-testing","term":"베타 테스트","term_en":"Beta Testing","definition":"출시 전 제품을 실제 사용자 집단에 배포하여 실환경에서 결함과 사용성 문제를 발견하는 외부 인수 테스트.","features":["개발자 통제 없는 실환경 수행","알파 테스트 이후 단계","대규모 사용자 피드백 수집","크라우드소싱 테스트로 확장 가능"],"related":["crowdsourcing","usability-testing","compatibility-testing"]},
 {"id":"big-bang-integration","term":"빅뱅 통합","term_en":"Big Bang Integration","definition":"단위 테스트를 마친 모든 모듈을 한 번에 결합하여 통합 테스트를 수행하는 비점진적 통합 방식.","features":["드라이버·스텁 불필요","결함 원인 모듈 격리 어려움","전체 모듈 완성 후 테스트 시작으로 지연","소규모·단순 시스템에 적합"],"related":["integration-testing","top-down-integration","bottom-up-integration"]},
 {"id":"black-box-testing","term":"블랙박스 테스트","term_en":"Black Box Testing","definition":"내부 구조를 보지 않고 요구 명세 기반 입력과 기대 출력만으로 기능을 검증하는 명세 기반 테스트.","features":["동등 분할·경계값·결정 테이블·상태 전이 기법","사용자 관점 기능 검증","코드 커버리지 측정 불가, 화이트박스와 보완","테스트 설계가 구현에 독립"],"related":["white-box-testing","equivalence-partitioning","boundary-value-analysis","decision-table-testing"]},
 {"id":"blast-radius","term":"폭발 반경","term_en":"Blast Radius","definition":"장애 또는 카오스 실험이 영향을 미치는 사용자·서비스·인프라의 범위.","features":["카오스 실험은 최소 반경에서 시작 후 점진 확대","킬스위치·롤백으로 반경 통제","서비스 격리 설계로 반경 축소","리스크 평가 기준으로 활용"],"related":["chaos-engineering","fault-injection","resilience"]},
 {"id":"bottom-up-integration","term":"상향식 통합 테스트","term_en":"Bottom-Up Integration Testing","definition":"최하위 모듈부터 클러스터로 묶어 테스트하고 점차 상위 모듈로 결합해 올라가는 점진적 통합 방식.","features":["상위 모듈 대체용 테스트 드라이버 필요","하위 세부 기능 조기 검증","스텁 불필요, 병행 개발 용이","상위 제어 결함 발견 지연"],"related":["integration-testing","test-driver","top-down-integration","sandwich-integration"]},
 {"id":"branch-coverage","term":"분기 커버리지","term_en":"Branch Coverage","definition":"프로그램의 모든 결정문이 참·거짓 분기를 각각 최소 1회 실행했는지 측정하는 코드 커버리지로, 결정 커버리지라고도 함.","features":["구문 커버리지를 포함하는 더 강한 기준","결정 결과만 보며 개별 조건은 미검증","ISO 26262 ASIL B·C, DO-178C Level B 요구","분기 수가 적어 실무 기본 목표"],"related":["code-coverage","statement-coverage","condition-coverage","modified-condition-decision-coverage"]},
 {"id":"breadth-first-search","term":"너비 우선 탐색","term_en":"Breadth-First Search (BFS)","definition":"그래프에서 시작 정점에 가까운 정점부터 순서대로 방문하는 탐색 알고리즘으로, 큐를 이용해 구현.","features":["큐에 인접 정점을 넣고 선입선출로 방문","가중치 없는 그래프 최단 경로 탐색","시간 복잡도 O(V+E)","깊이 우선 탐색과 대비"],"related":["fifo","circular-queue"]},
 {"id":"buffer","term":"버퍼","term_en":"Buffer","definition":"속도·시점이 다른 두 장치나 프로세스 사이에서 데이터를 임시 저장하는 메모리 영역.","features":["생산자·소비자 속도 차이 완충","큐 구조로 선입선출 처리","크기 초과 시 오버플로우 발생","링 버퍼로 고성능 I/O 구현"],"related":["circular-queue","overflow","fifo"]},
 {"id":"bug-bounty","term":"버그 바운티","term_en":"Bug Bounty","definition":"외부 보안 연구자가 취약점을 발견해 제보하면 심각도에 따라 보상하는 크라우드소싱 기반 취약점 발굴 프로그램.","features":["유효 취약점 건별 보상","크라우드소싱 테스트의 보안 분야 모델","제보 범위·규칙 사전 공개","HackerOne 등 플랫폼 중개"],"related":["crowdsourcing","penetration-testing"]},
 {"id":"burndown-chart","term":"번다운 차트","term_en":"Burndown Chart","definition":"스프린트나 릴리스에서 남은 작업량을 시간에 따라 그래프로 표시하여 진척을 시각화하는 애자일 도구.","features":["이상선과 실제선 비교로 지연 조기 감지","스토리 포인트 또는 작업 시간 단위","스크럼에서 일일 갱신","칸반은 누적 흐름도를 주로 사용"],"related":["scrum","sprint","velocity","cumulative-flow-diagram"]},
 {"id":"canary-deployment","term":"카나리 배포","term_en":"Canary Deployment","definition":"새 버전을 소수 사용자·서버에 먼저 배포해 지표를 관찰하고 문제 없으면 점진적으로 전체 확대하는 배포 전략.","features":["폭발 반경 제한으로 위험 감소","실트래픽 기반 검증","자동 롤백 조건 설정","카오스 실험 대상 그룹으로 활용"],"related":["blast-radius","devops","ci-cd-pipeline"]},
 {"id":"cause-and-effect-diagram","term":"특성요인도","term_en":"Cause-and-Effect Diagram","definition":"결과(특성)에 영향을 주는 원인을 사람·방법·기계·재료·환경 등으로 체계적으로 분류해 생선뼈 모양으로 표현하는 QC 도구(이시카와 다이어그램).","features":["4M·6M 분류로 원인 누락 방지","브레인스토밍 결과 구조화","SPC 이상 원인 분석에 활용","근본 원인 분석의 출발점"],"related":["seven-qc-tools","control-chart","pareto-chart"]},
 {"id":"chaos-engineering","term":"카오스 엔지니어링","term_en":"Chaos Engineering","definition":"운영 환경의 분산 시스템에 통제된 장애를 주입하는 실험으로 시스템의 회복탄력성을 검증·개선하는 공학 분야.","features":["정상 상태 가설 정의 후 실험","실제 발생 가능한 장애 유형 재현","폭발 반경 최소화와 자동화","Netflix Chaos Monkey에서 출발"],"related":["chaos-monkey","fault-injection","blast-radius","resilience","observability"]},
 {"id":"chaos-monkey","term":"카오스 몽키","term_en":"Chaos Monkey","definition":"Netflix가 2011년 공개한 도구로, 운영 환경의 인스턴스를 무작위로 종료하여 서비스가 장애에 견디는지 상시 검증.","features":["업무 시간 중 무작위 인스턴스 종료","Simian Army(지연·리전 장애 등)로 확장","회복탄력성 설계를 강제하는 문화 도구","Spinnaker 연동 오픈소스"],"related":["chaos-engineering","fault-injection","microservices"]},
 {"id":"check-sheet","term":"체크시트","term_en":"Check Sheet","definition":"데이터 수집을 표준화하기 위해 항목별 발생 횟수를 기록하도록 미리 양식화한 QC 도구.","features":["수집 즉시 집계 가능","결함 유형·위치별 빈도 기록","파레토도·히스토그램의 입력 데이터","단순하고 현장 적용 용이"],"related":["seven-qc-tools","pareto-chart","histogram"]},
 {"id":"checklist","term":"체크리스트","term_en":"Checklist","definition":"검토·검사 시 확인해야 할 항목을 사전에 목록화한 문서로, 누락 없이 일관된 점검을 보장.","features":["과거 결함 유형에서 항목 도출","인스펙션 검사표로 활용","검토자 경험 의존도 감소","주기적 개정으로 효과 유지"],"related":["fagan-inspection","peer-review","code-review"]},
 {"id":"circuit-breaker","term":"서킷 브레이커","term_en":"Circuit Breaker","definition":"의존 서비스 호출 실패가 임계치를 넘으면 일정 시간 호출을 차단하고 폴백을 반환하여 장애 전파를 막는 회복탄력성 패턴.","features":["Closed·Open·Half-Open 상태 전이","연쇄 장애 방지, 빠른 실패","Resilience4j·Hystrix 구현","카오스 테스트로 동작 검증"],"related":["resilience","microservices","chaos-engineering"]},
 {"id":"circular-queue","term":"원형 큐","term_en":"Circular Queue","definition":"배열의 끝과 처음을 모듈러 연산으로 연결하여 삭제된 앞 공간을 재사용하는 큐 구현.","features":["rear=(rear+1) mod n, front=(front+1) mod n","선형 배열 큐의 거짓 포화 해결","한 칸 비우기 또는 count로 공백·포화 구분","링 버퍼로 I/O·네트워크에 활용"],"related":["fifo","buffer","linked-list","dynamic-array"]},
 {"id":"class-diagram","term":"클래스 다이어그램","term_en":"Class Diagram","definition":"시스템의 클래스, 속성, 연산과 클래스 간 연관·상속·집합 관계를 표현하는 UML 정적 구조 다이어그램.","features":["연관·집합·합성·일반화·의존 관계 표기","다중성과 역할 명시","컴포넌트 식별 시 클래스 군집 분석에 활용","코드 생성·역공학 가능"],"related":["use-case","software-component","component-based-development"]},
 {"id":"clipping-window","term":"클리핑 윈도우","term_en":"Clipping Window","definition":"컴퓨터 그래픽스에서 화면에 표시할 영역을 정의하는 직사각형 경계로, 이 밖의 객체는 클리핑으로 제거.","features":["xmin·xmax·ymin·ymax 네 경계","영역 코드 산출 기준","뷰포트로 변환되어 화면 표시","3차원에서는 뷰 볼륨으로 확장"],"related":["line-clipping","region-code","viewport","computer-graphics"]},
 {"id":"cmmi","term":"CMMI","term_en":"Capability Maturity Model Integration","definition":"SEI가 개발한 프로세스 성숙도 모델로, 조직의 개발·관리 프로세스를 5단계 성숙도(초기·관리·정의·정량관리·최적화)로 평가·개선.","features":["단계적·연속적 표현 제공","프로세스 영역별 특정·일반 목표와 실천","3단계 IPM, 4단계 SPC 기반 정량 관리","v2.0·v3.0에서 실천 영역으로 재구성"],"related":["organizational-standard-process","process-tailoring","organizational-process-assets","control-chart"]},
 {"id":"code-coverage","term":"코드 커버리지","term_en":"Code Coverage","definition":"테스트 실행으로 소스 코드의 구문·분기·조건·경로가 실행된 비율을 측정하는 화이트박스 테스트 완전성 지표.","features":["구문·분기·조건·MC/DC·다중조건·경로 등 종류","계측 도구(JaCoCo·gcov)로 자동 측정","안전 필수 표준의 인증 요건","높은 커버리지가 결함 부재를 보장하지 않음"],"related":["statement-coverage","branch-coverage","modified-condition-decision-coverage","white-box-testing"]},
 {"id":"cohesion","term":"응집도","term_en":"Cohesion","definition":"모듈 내부 구성요소들이 하나의 목적을 위해 얼마나 밀접하게 관련되어 있는지의 정도로, 높을수록 좋은 설계.","features":["기능적>순차적>통신적>절차적>시간적>논리적>우연적","높은 응집도는 이해·재사용·유지보수 용이","컴포넌트 식별 기준","결합도와 함께 모듈화 품질 척도"],"related":["coupling","module","software-component"]},
 {"id":"common-cause-variation","term":"우연 원인 변동","term_en":"Common Cause Variation","definition":"프로세스에 내재되어 항상 존재하는 무작위적 변동으로, 관리 한계 내에서 발생하며 프로세스 자체 개선으로만 감소.","features":["시스템 고유의 안정적 변동","관리 상태의 프로세스는 우연 원인만 존재","개별 조치(과조정)는 오히려 변동 증가","이상 원인과 구분이 SPC의 핵심"],"related":["special-cause-variation","control-chart","control-limit"]},
 {"id":"compatibility-testing","term":"호환성 테스트","term_en":"Compatibility Testing","definition":"SW가 다양한 하드웨어·OS·브라우저·네트워크·기기 조합에서 정상 동작하는지 검증하는 비기능 테스트.","features":["기기·OS 파편화 대응","크라우드소싱·디바이스 팜 활용","상위·하위 버전 호환 포함","조합 폭증으로 페어와이즈 기법 적용"],"related":["crowdsourcing","beta-testing","localization-testing"]},
 {"id":"component-based-development","term":"컴포넌트 기반 개발","term_en":"Component-Based Development (CBD)","definition":"재사용 가능한 컴포넌트를 식별·개발·조립하여 SW를 구축하는 개발 방법론.","features":["인터페이스 계약 기반 조립","개발 생산성·재사용성 향상","컴포넌트 식별이 핵심 설계 활동","CORBA·EJB·.NET 컴포넌트 모델 기반"],"related":["software-component","interface","reusability","cohesion","coupling"]},
 {"id":"computer-graphics","term":"컴퓨터 그래픽스","term_en":"Computer Graphics","definition":"컴퓨터로 영상을 생성·처리·표시하는 기술 분야로, 모델링·변환·클리핑·래스터화·렌더링 파이프라인으로 구성.","features":["기하 변환과 투영","클리핑으로 가시 영역 외 객체 제거","래스터화와 은면 제거","GPU 파이프라인으로 하드웨어 가속"],"related":["line-clipping","clipping-window","viewport"]},
 {"id":"condition-coverage","term":"조건 커버리지","term_en":"Condition Coverage","definition":"결정문을 구성하는 각 개별 조건이 참과 거짓을 모두 가졌는지 측정하는 코드 커버리지.","features":["개별 조건 중심, 결정 결과는 미보장","분기 커버리지와 독립적 기준","조건·결정 커버리지로 결합 가능","MC/DC의 기초"],"related":["branch-coverage","modified-condition-decision-coverage","multiple-condition-coverage","code-coverage"]},
 {"id":"conflict-management","term":"갈등 관리","term_en":"Conflict Management","definition":"프로젝트 팀 내 의견·이해 충돌을 인식하고 협력·타협·회피·강요·수용 등의 방식으로 해결하는 관리 활동.","features":["협력(문제 해결)이 가장 지속적 해결","터크만 혼돈 단계의 핵심 리더 활동","갈등 원인: 일정·우선순위·자원·기술","건설적 갈등은 창의성 촉진"],"related":["team-development","leadership","situational-leadership"]},
 {"id":"control-chart","term":"관리도","term_en":"Control Chart","definition":"프로세스 측정값을 시간 순으로 표시하고 중심선과 상·하 관리 한계를 두어 이상 원인 발생을 탐지하는 SPC 핵심 도구.","features":["CL과 UCL·LCL=CL±3σ","계량형(X̄-R, I-MR)과 계수형(p, c, u)","런 규칙으로 비무작위 패턴 탐지","관리 한계는 규격 한계와 다름"],"related":["control-limit","common-cause-variation","special-cause-variation","seven-qc-tools"]},
 {"id":"control-flow-graph","term":"제어 흐름 그래프","term_en":"Control Flow Graph","definition":"프로그램의 문장 블록을 노드, 제어 이동을 간선으로 표현하여 분기·반복 구조를 나타내는 그래프.","features":["순환 복잡도 계산 기반","기본 경로 테스트의 입력","결정 노드로 조건문·루프 표현","정적 분석 도구로 자동 생성"],"related":["cyclomatic-complexity","basis-path-testing","white-box-testing"]},
 {"id":"control-limit","term":"관리 한계","term_en":"Control Limit","definition":"관리도에서 프로세스의 우연 변동 범위를 나타내는 상한(UCL)·하한(LCL)으로, 보통 중심선 ±3σ로 설정.","features":["프로세스 데이터로부터 통계적으로 산출","이탈 점은 이상 원인 신호","고객 요구인 규격 한계와 구분","프로세스 개선 후 재산출"],"related":["control-chart","common-cause-variation","special-cause-variation"]},
 {"id":"coupling","term":"결합도","term_en":"Coupling","definition":"모듈 간 상호 의존 정도로, 낮을수록 독립성이 높아 변경 영향과 재사용 비용이 감소.","features":["자료<스탬프<제어<외부<공통<내용 순으로 강해짐","낮은 결합도가 좋은 설계","컴포넌트 간 순환 의존 제거 기준","응집도와 함께 모듈화 척도"],"related":["cohesion","module","interface"]},
 {"id":"critical-chain","term":"크리티컬 체인","term_en":"Critical Chain","definition":"작업 종속성과 자원 제약을 모두 고려하여 자원 평준화 후 프로젝트 완료를 결정하는 가장 긴 작업 연쇄.","features":["CPM의 주공정에 자원 제약 반영","프로젝트 버퍼로 보호","작업은 릴레이 방식으로 집중 수행","자원 경합 해소 시 경로 변경 가능"],"related":["theory-of-constraints","critical-path-method","project-buffer","feeding-buffer"]},
 {"id":"critical-path-method","term":"주공정법","term_en":"Critical Path Method (CPM)","definition":"작업 네트워크에서 여유 시간이 0인 가장 긴 경로(주공정)를 찾아 프로젝트 최단 완료 기간을 산정하는 일정 기법.","features":["전진·후진 계산으로 여유 시간 산출","주공정 지연은 프로젝트 지연","자원 제약 미반영이 한계","CCPM이 자원 제약을 보완"],"related":["critical-chain","theory-of-constraints","project-buffer"]},
 {"id":"crowdsourcing","term":"크라우드소싱","term_en":"Crowdsourcing","definition":"특정 과업을 온라인 플랫폼을 통해 불특정 다수에게 공개 위탁하고 성과에 따라 보상하는 협업 모델.","features":["개방형 참여와 성과 기반 보상","다양성·규모의 확보","플랫폼이 중개·검증","테스트·보안·데이터 라벨링에 적용"],"related":["bug-bounty","beta-testing","compatibility-testing"]},
 {"id":"cumulative-flow-diagram","term":"누적 흐름도","term_en":"Cumulative Flow Diagram (CFD)","definition":"시간에 따라 각 작업 단계에 있는 항목 수를 누적 영역으로 표시하여 WIP·리드타임·처리량을 한눈에 보여주는 칸반 지표.","features":["띠의 수직 폭이 WIP, 수평 폭이 리드타임","띠 확대는 병목 신호","처리량 추세로 완료 예측","리틀의 법칙 시각화"],"related":["kanban-board","work-in-progress-limit","lead-time","cycle-time"]},
 {"id":"cycle-time","term":"사이클타임","term_en":"Cycle Time","definition":"작업이 실제로 착수된 시점부터 완료될 때까지 걸린 시간으로, 흐름 효율 측정 지표.","features":["리드타임 중 실작업 구간","WIP 제한으로 단축","리틀의 법칙: WIP=처리량×사이클타임","칸반 핵심 측정값"],"related":["lead-time","work-in-progress-limit","cumulative-flow-diagram"]},
 {"id":"cyclomatic-complexity","term":"순환 복잡도","term_en":"Cyclomatic Complexity","definition":"McCabe가 제안한 코드 복잡도 척도로, 제어 흐름 그래프의 선형 독립 경로 수 V(G)=E-N+2 또는 결정 노드 수+1.","features":["기본 경로 테스트의 경로 수","10 초과 시 분할·리팩토링 권고","정적 분석 도구로 자동 산출","결함 밀도와 상관"],"related":["control-flow-graph","basis-path-testing","refactoring"]},
 {"id":"decision-table-testing","term":"결정 테이블 테스트","term_en":"Decision Table Testing","definition":"조건 조합과 그에 따른 행동을 표로 정리하고 각 규칙(열)을 테스트 케이스로 도출하는 블랙박스 기법.","features":["복잡한 비즈니스 규칙 조합 검증","무관 조건(-)으로 규칙 축소","누락·모순 규칙 발견","동등 분할·경계값과 병행"],"related":["black-box-testing","equivalence-partitioning","boundary-value-analysis","test-case"]},
 {"id":"deque","term":"덱","term_en":"Deque (Double-Ended Queue)","definition":"양쪽 끝에서 삽입과 삭제가 모두 가능한 선형 자료구조로, 큐와 스택을 일반화.","features":["front·rear 모두에서 push·pop","원형 배열 또는 이중 연결 리스트로 구현","입력 제한·출력 제한 덱 변형","슬라이딩 윈도우 알고리즘에 활용"],"related":["circular-queue","linked-list","priority-queue"]},
 {"id":"devops","term":"데브옵스","term_en":"DevOps","definition":"개발과 운영이 협력하여 자동화된 파이프라인으로 빠르고 안정적으로 SW를 전달하는 문화·실천·도구의 결합.","features":["CI/CD·IaC·모니터링 자동화","짧은 배포 주기와 빠른 피드백","카오스 엔지니어링·SRE와 연계","문화·측정·공유 강조"],"related":["ci-cd-pipeline","site-reliability-engineering","chaos-engineering","canary-deployment"]},
 {"id":"domain-driven-design","term":"도메인 주도 설계","term_en":"Domain-Driven Design (DDD)","definition":"비즈니스 도메인 모델을 중심으로 유비쿼터스 언어와 바운디드 컨텍스트로 시스템을 설계하는 방법론.","features":["바운디드 컨텍스트로 모델 경계 명확화","엔티티·값 객체·애그리거트 전술 패턴","마이크로서비스 경계 식별에 활용","도메인 전문가와 개발자 협업"],"related":["microservices","component-based-development","software-component"]},
 {"id":"drum-buffer-rope","term":"드럼-버퍼-로프","term_en":"Drum-Buffer-Rope (DBR)","definition":"제약이론의 생산 통제 기법으로, 제약 자원(드럼)의 속도에 맞춰 버퍼로 보호하고 투입 시점(로프)을 통제.","features":["드럼: 제약 자원의 일정","버퍼: 제약 앞 시간 여유","로프: 드럼에 동기화된 자재 투입","다중 프로젝트 CCPM의 착수 통제 원리"],"related":["theory-of-constraints","critical-chain","project-buffer"]},
 {"id":"dynamic-array","term":"동적 배열","term_en":"Dynamic Array","definition":"용량이 가득 차면 더 큰 배열을 할당해 복사함으로써 크기를 자동 확장하는 배열 구조.","features":["보통 2배 확장으로 평균 O(1) 삽입","확장 순간 O(n) 복사 비용","임의 접근 O(1) 유지","배열 큐의 고정 크기 한계 해결"],"related":["circular-queue","linked-list","overflow"]},
 {"id":"encapsulation","term":"캡슐화","term_en":"Encapsulation","definition":"데이터와 그 데이터를 처리하는 연산을 하나로 묶고 내부 구현을 외부로부터 숨겨 인터페이스로만 접근하게 하는 객체 지향 원리.","features":["정보 은닉으로 변경 영향 최소화","인터페이스와 구현 분리","컴포넌트의 핵심 특성","결합도 감소"],"related":["interface","information-hiding","software-component","coupling"]},
 {"id":"expected-result","term":"기대 결과","term_en":"Expected Result","definition":"테스트 케이스 실행 시 요구사항에 따라 산출되어야 하는 올바른 출력·상태로, 테스트 오라클이 제공.","features":["실제 결과와 비교해 합격·불합격 판정","테스트 케이스 필수 구성요소","명세·수식·레거시 시스템에서 도출","자동화 시 골든 파일로 저장"],"related":["test-case","test-oracle","test-plan"]},
 {"id":"exploratory-testing","term":"탐색적 테스트","term_en":"Exploratory Testing","definition":"테스터가 사전 설계된 케이스 없이 학습·설계·실행을 동시에 수행하며 경험과 직관으로 결함을 찾는 테스트.","features":["테스트 차터로 범위·시간 제한","스크립트 테스트가 놓치는 결함 발견","세션 기반으로 기록·보고","크라우드소싱 테스트에 적합"],"related":["crowdsourcing","usability-testing","black-box-testing"]},
 {"id":"extreme-programming","term":"익스트림 프로그래밍","term_en":"Extreme Programming (XP)","definition":"Kent Beck이 제안한 애자일 방법론으로, TDD·페어 프로그래밍·지속 통합·리팩토링·작은 릴리스 등 실천법을 극단적으로 적용.","features":["의사소통·단순성·피드백·용기·존중 5가치","TDD와 리팩토링이 핵심 실천","고객 상주와 짧은 반복","소규모 팀에 적합"],"related":["test-driven-development","pair-programming","refactoring","agile"]},
 {"id":"fagan-inspection","term":"Fagan 인스펙션","term_en":"Fagan Inspection","definition":"1976년 IBM의 Michael Fagan이 정립한 정형 검토 기법으로, 계획·개요·준비·검사 회의·재작업·후속 확인의 6단계와 역할 분담으로 결함을 발견.","features":["진행자·작성자·낭독자·검토자 역할","검사표 기반 결함 식별","결함 발견과 해결 논의 분리","결함 데이터로 프로세스 개선"],"related":["peer-review","checklist","moderator","code-review"]},
 {"id":"fault-injection","term":"장애 주입","term_en":"Fault Injection","definition":"시스템에 의도적으로 오류·장애(지연·종료·자원 고갈 등)를 삽입하여 오류 처리와 복원 능력을 검증하는 기법.","features":["HW·SW·네트워크 수준 주입","카오스 엔지니어링의 핵심 수단","예외 경로·폴백 로직 검증","Chaos Mesh·Gremlin 도구"],"related":["chaos-engineering","blast-radius","resilience","chaos-monkey"]},
 {"id":"feeding-buffer","term":"피딩 버퍼","term_en":"Feeding Buffer","definition":"CCPM에서 비핵심 작업 체인이 크리티컬 체인에 합류하는 지점에 두는 시간 여유로, 비핵심 작업 지연이 핵심 체인에 전파되는 것을 차단.","features":["비핵심 체인 제거 여유의 약 50%","합류 지점마다 배치","프로젝트 버퍼와 함께 납기 보호","소진율로 모니터링"],"related":["critical-chain","project-buffer","resource-buffer"]},
 {"id":"fifo","term":"선입선출","term_en":"First In First Out (FIFO)","definition":"먼저 들어온 데이터가 먼저 나가는 처리 원칙으로, 큐의 기본 동작 방식.","features":["도착 순서 보장","큐·버퍼·스케줄링에 적용","스택의 LIFO와 대비","페이지 교체 알고리즘에도 사용"],"related":["circular-queue","buffer","deque"]},
 {"id":"game-day","term":"게임데이","term_en":"Game Day","definition":"운영·개발팀이 모여 계획된 장애 시나리오를 실제로 실행하고 대응 절차를 훈련·검증하는 카오스 엔지니어링 실습 행사.","features":["장애 대응 런북 검증","팀 간 소통·역할 확인","발견된 취약점 개선 과제화","정기적 반복으로 조직 학습"],"related":["chaos-engineering","site-reliability-engineering","resilience"]},
 {"id":"heuristic-oracle","term":"휴리스틱 오라클","term_en":"Heuristic Oracle","definition":"일부 입력에는 정확한 기대값을 제공하고 나머지 입력에는 경험적 규칙·추정으로 결과를 판정하는 테스트 오라클 유형.","features":["넓은 입력 범위를 저비용으로 판정","규칙 오류 시 오판 가능","샘플링 오라클의 확장","참 오라클 구축 불가 시 대안"],"related":["test-oracle","test-oracle-problem","expected-result"]},
 {"id":"histogram","term":"히스토그램","term_en":"Histogram","definition":"데이터를 구간별 빈도로 막대 그래프화하여 분포의 중심·산포·형태를 파악하는 QC 도구.","features":["정규성·이봉 분포 등 형태 확인","규격 한계와 비교해 공정능력 가늠","체크시트 데이터로 작성","관리도의 보조 분석"],"related":["seven-qc-tools","process-capability-index","check-sheet"]},
 {"id":"integration-testing","term":"통합 테스트","term_en":"Integration Testing","definition":"단위 테스트를 마친 모듈을 결합하면서 모듈 간 인터페이스와 상호작용의 결함을 검출하는 테스트 단계.","features":["빅뱅·하향식·상향식·샌드위치 전략","드라이버·스텁 등 보조 모듈 사용","인터페이스 명세 기반 케이스","결합마다 회귀 테스트"],"related":["unit-testing","top-down-integration","bottom-up-integration","test-driver","test-stub"]},
 {"id":"interface","term":"인터페이스","term_en":"Interface","definition":"모듈·컴포넌트가 외부에 제공하거나 요구하는 오퍼레이션의 명세로, 구현과 분리된 상호작용 계약.","features":["제공 인터페이스와 요구 인터페이스","구현 교체 가능성 확보","결합도 감소의 핵심 수단","인터페이스 검사가 통합 테스트 핵심"],"related":["software-component","encapsulation","coupling","component-based-development"]},
 {"id":"iso-26262","term":"ISO 26262","term_en":"ISO 26262 Road Vehicles Functional Safety","definition":"자동차 전기·전자 시스템의 기능 안전 국제 표준으로, ASIL 등급(A~D)에 따라 개발·검증 요구사항을 규정.","features":["ASIL D 최고 안전 등급","등급별 코드 커버리지(구문·분기·MC/DC) 권고","안전 생명주기 전반 요구","HARA 기반 위험 분석"],"related":["code-coverage","modified-condition-decision-coverage","branch-coverage"]},
 {"id":"kanban-board","term":"칸반 보드","term_en":"Kanban Board","definition":"작업 단계를 열로, 작업 항목을 카드로 표현하여 작업 흐름과 WIP를 시각화하는 칸반의 핵심 도구.","features":["열별 WIP 제한 표시","차단·병목 즉시 가시화","물리 보드 또는 Jira·Trello","영속 보드로 스프린트 초기화 없음"],"related":["work-in-progress-limit","pull-system","cumulative-flow-diagram","scrum"]},
 {"id":"kubernetes","term":"쿠버네티스","term_en":"Kubernetes","definition":"컨테이너화된 애플리케이션의 배포·확장·운영을 자동화하는 오픈소스 컨테이너 오케스트레이션 플랫폼.","features":["Pod 단위 배포와 자동 복구","선언적 설정과 오토스케일링","서비스 디스커버리·롤링 업데이트","카오스 도구(Litmus·Chaos Mesh) 실험 대상"],"related":["containerization","auto-scaling","chaos-engineering","microservices"]},
 {"id":"lead-time","term":"리드타임","term_en":"Lead Time","definition":"작업 요청이 접수된 시점부터 고객에게 전달될 때까지 걸린 총 시간으로, 대기 시간을 포함.","features":["고객 관점 응답 속도 지표","사이클타임+대기 시간","WIP 감소로 단축","칸반·린의 핵심 측정값"],"related":["cycle-time","work-in-progress-limit","cumulative-flow-diagram","lean"]},
 {"id":"leadership","term":"리더십","term_en":"Leadership","definition":"목표 달성을 위해 팀 구성원에게 비전을 제시하고 동기를 부여하며 영향력을 행사하는 능력.","features":["지시·코칭·지원·위임 스타일","팀 발달 단계에 따라 전환","갈등 관리와 동기부여 포함","프로젝트 관리자의 핵심 대인 기술"],"related":["situational-leadership","team-development","conflict-management","team-building"]},
 {"id":"lean","term":"린","term_en":"Lean","definition":"도요타 생산방식에서 유래한 낭비 제거와 가치 흐름 최적화 철학으로, SW 개발에서는 린 소프트웨어 개발 7원칙으로 적용.","features":["낭비 제거·학습 증폭·늦은 결정·빠른 전달","풀 시스템과 WIP 제한","가치 흐름 매핑","칸반의 이론적 기반"],"related":["kanban-board","pull-system","work-in-progress-limit","agile"]},
 {"id":"liang-barsky-algorithm","term":"Liang-Barsky 알고리즘","term_en":"Liang-Barsky Line Clipping Algorithm","definition":"선분을 매개변수 방정식으로 표현하고 각 경계에 대한 매개변수 t의 진입·이탈 구간을 계산하여 클리핑하는 알고리즘.","features":["교점 계산 최소화, 나눗셈 적음","부분 교차 선분에서 코헨-서덜랜드보다 효율적","직사각형 윈도우에 최적화","3차원 확장 용이"],"related":["line-clipping","clipping-window","sutherland-hodgman-algorithm"]},
 {"id":"line-clipping","term":"선분 클리핑","term_en":"Line Clipping","definition":"클리핑 윈도우 내부에 있는 선분의 가시 부분만 남기고 외부 부분을 제거하는 그래픽스 처리.","features":["코헨-서덜랜드·Liang-Barsky 등 알고리즘","래스터화 전 수행으로 연산 절감","완전 수용·완전 기각·부분 교차 분류","다각형 클리핑과 구분"],"related":["clipping-window","region-code","liang-barsky-algorithm","computer-graphics"]},
 {"id":"linked-list","term":"연결 리스트","term_en":"Linked List","definition":"각 노드가 데이터와 다음 노드 포인터를 가지며 동적으로 연결되는 선형 자료구조.","features":["크기 제한 없이 동적 할당","삽입·삭제 O(1), 임의 접근 O(n)","포인터 메모리 추가, 캐시 비효율","큐·스택 구현에 활용"],"related":["circular-queue","dynamic-array","deque"]},
 {"id":"localization-testing","term":"현지화 테스트","term_en":"Localization Testing","definition":"SW가 특정 지역·언어·문화에 맞게 번역·날짜·통화·결제 등이 올바르게 적용되었는지 검증하는 테스트.","features":["번역 품질과 UI 레이아웃 확인","지역 규제·결제 수단 검증","현지 테스터 활용에 적합","국제화(i18n) 테스트와 연계"],"related":["crowdsourcing","compatibility-testing","usability-testing"]},
 {"id":"loop-testing","term":"루프 테스트","term_en":"Loop Testing","definition":"반복 구조의 유효성을 검증하기 위해 0회·1회·2회·최대-1회·최대회·최대+1회 등 반복 횟수를 달리하여 테스트하는 화이트박스 기법.","features":["단순·중첩·연접·비구조 루프 구분","종료 조건과 경계 오류 검출","제어 흐름 테스트 보완","off-by-one 오류 발견"],"related":["control-flow-graph","white-box-testing","basis-path-testing"]},
 {"id":"metamorphic-testing","term":"메타모픽 테스트","term_en":"Metamorphic Testing","definition":"정답을 알 수 없을 때 입력 변환과 출력 사이에 성립해야 하는 관계(메타모픽 관계)를 검증하는 테스트 기법.","features":["테스트 오라클 문제의 대안","예: sin(x)=sin(π-x), 정렬 입력 순서 변경 시 결과 동일","ML·과학 계산·검색 엔진 검증","기존 테스트에서 후속 테스트 자동 생성"],"related":["test-oracle","test-oracle-problem","heuristic-oracle"]},
 {"id":"mock-object","term":"목 객체","term_en":"Mock Object","definition":"실제 의존 객체를 대신해 미리 정의된 응답을 반환하고 호출 여부·인자를 검증하는 테스트 대역.","features":["DB·네트워크 등 외부 의존 격리","상호작용(호출 횟수·순서) 검증","Mockito·Moq 등 프레임워크","스텁보다 검증 기능 강화"],"related":["test-stub","test-driver","unit-testing","test-driven-development"]},
 {"id":"moderator","term":"진행자","term_en":"Moderator","definition":"인스펙션 회의를 계획·주관하고 검토 범위와 시간을 통제하며 결함 기록과 후속 조치 확인을 책임지는 역할.","features":["작성자와 독립된 교육받은 인원","결함 발견에 집중하도록 회의 통제","재작업 완료 검증","인스펙션 지표 관리"],"related":["fagan-inspection","peer-review","checklist"]},
 {"id":"modified-condition-decision-coverage","term":"MC/DC 커버리지","term_en":"Modified Condition/Decision Coverage","definition":"각 개별 조건이 다른 조건을 고정한 채 단독으로 결정 결과를 변경함을 보이는 테스트 케이스가 모두 존재해야 하는 커버리지.","features":["n개 조건에 최소 n+1개 케이스","다중 조건의 2^n 폭증을 회피","DO-178C Level A, ISO 26262 ASIL D 요구","조건·결정 커버리지를 포함"],"related":["condition-coverage","branch-coverage","multiple-condition-coverage","iso-26262"]},
 {"id":"module","term":"모듈","term_en":"Module","definition":"프로그램을 기능 단위로 분할한 소스 코드 수준의 독립 단위로, 함수·프로시저·클래스의 집합.","features":["응집도 높고 결합도 낮게 설계","소스 수준 재사용, 컴파일 필요","컴포넌트의 구성 요소","단위 테스트 대상"],"related":["cohesion","coupling","software-component","unit-testing"]},
 {"id":"multiple-condition-coverage","term":"다중 조건 커버리지","term_en":"Multiple Condition Coverage","definition":"결정문의 모든 개별 조건 조합(2^n)을 전부 실행하는 가장 강력한 조건 기반 커버리지.","features":["완전한 조건 조합 검증","조건 수 증가 시 케이스 지수적 폭증","MC/DC가 실용적 대안","단락 평가 언어에서는 일부 조합 불가"],"related":["modified-condition-decision-coverage","condition-coverage","code-coverage"]},
 {"id":"multitasking","term":"멀티태스킹","term_en":"Multitasking","definition":"한 자원이 여러 작업을 동시에 번갈아 수행하는 것으로, CCPM에서는 전환 비용과 모든 작업의 지연을 유발하는 나쁜 관행으로 간주.","features":["작업 전환 비용으로 총 소요 시간 증가","CCPM은 릴레이 방식 집중 작업 권장","칸반 WIP 제한으로 억제","개인·조직 수준 모두 발생"],"related":["critical-chain","student-syndrome","work-in-progress-limit"]},
 {"id":"mutation-testing","term":"변이 테스트","term_en":"Mutation Testing","definition":"코드에 작은 인위적 결함(변이)을 삽입한 변이체를 테스트 스위트가 검출하는지 측정하여 테스트 품질을 평가하는 기법.","features":["변이 점수 = 검출 변이/전체 변이","커버리지만으로 못 잡는 약한 단언 발견","동등 변이체 처리 문제","PIT·Stryker 도구"],"related":["code-coverage","unit-testing","test-case"]},
 {"id":"observability","term":"관측 가능성","term_en":"Observability","definition":"메트릭·로그·추적 등 외부 출력만으로 시스템 내부 상태를 추론할 수 있는 정도.","features":["메트릭·로그·분산 추적 3요소","카오스 실험 가설 검증의 전제","Prometheus·Grafana·OpenTelemetry","모니터링보다 미지의 문제 탐색에 초점"],"related":["chaos-engineering","site-reliability-engineering","microservices"]},
 {"id":"off-by-one-error","term":"off-by-one 오류","term_en":"Off-by-One Error","definition":"루프 경계나 배열 인덱스에서 1만큼 많거나 적게 처리하는 흔한 논리 오류.","features":["< 와 <= 혼동, 0·1 시작 인덱스 혼동","루프 경계 검사 항목","경계값 분석으로 검출","배열 범위 초과 유발"],"related":["loop-testing","boundary-value-analysis","checklist"]},
 {"id":"organizational-process-assets","term":"조직 프로세스 자산","term_en":"Organizational Process Assets","definition":"조직이 프로젝트에서 활용하도록 축적한 표준 프로세스, 생명주기 모델, 테일러링 가이드, 측정 저장소, 교훈 등의 자산.","features":["CMMI OPD로 정의·유지","프로젝트가 활용하고 결과를 환류","프로세스 자산 라이브러리에 저장","PMBOK의 조직 프로세스 자산과 대응"],"related":["organizational-standard-process","process-asset-library","process-tailoring","cmmi"]},
 {"id":"organizational-standard-process","term":"조직 표준 프로세스","term_en":"Organizational Standard Process","definition":"조직 차원에서 정의하여 모든 프로젝트가 테일러링해 사용하는 기준 프로세스 집합.","features":["CMMI 3단계의 기반","테일러링 가이드라인과 함께 제공","프로젝트 정의 프로세스의 원천","측정 데이터 비교 가능성 확보"],"related":["process-tailoring","organizational-process-assets","cmmi"]},
 {"id":"overflow","term":"오버플로우","term_en":"Overflow","definition":"자료구조나 저장 공간의 용량을 초과하여 삽입을 시도할 때 발생하는 상태.","features":["고정 크기 배열 큐·스택에서 발생","원형 큐의 거짓 포화와 구분","동적 자료구조로 회피","오류 처리·차단 정책 필요"],"related":["circular-queue","buffer","dynamic-array"]},
 {"id":"pair-programming","term":"페어 프로그래밍","term_en":"Pair Programming","definition":"두 개발자가 한 컴퓨터에서 드라이버와 내비게이터 역할을 교대하며 함께 코드를 작성하는 XP 실천법.","features":["실시간 코드 리뷰 효과","지식 공유와 결함 감소","TDD와 핑퐁 방식 결합","초기 생산성 비용 대비 품질 향상"],"related":["extreme-programming","test-driven-development","code-review"]},
 {"id":"pareto-chart","term":"파레토도","term_en":"Pareto Chart","definition":"문제 원인·유형을 빈도 순으로 막대 정렬하고 누적 비율 곡선을 함께 표시하여 중점 관리 대상을 식별하는 QC 도구.","features":["80:20 원칙 적용","소수 핵심 원인에 자원 집중","체크시트 데이터 기반","SPC 이상 원인 우선순위화"],"related":["seven-qc-tools","check-sheet","cause-and-effect-diagram"]},
 {"id":"parkinsons-law","term":"파킨슨 법칙","term_en":"Parkinson's Law","definition":"일은 주어진 시간을 모두 채울 때까지 늘어난다는 법칙으로, 작업이 일찍 끝나도 여유가 소진되는 현상.","features":["조기 완료 미보고로 여유 손실","CCPM이 안전 여유 제거로 대응","학생 증후군과 함께 일정 지연 원인","릴레이 방식 완료 즉시 전달로 극복"],"related":["student-syndrome","critical-chain","project-buffer"]},
 {"id":"path-coverage","term":"경로 커버리지","term_en":"Path Coverage","definition":"프로그램 시작부터 끝까지 가능한 모든 실행 경로를 실행했는지 측정하는 커버리지.","features":["루프 존재 시 경로 수 폭증","기본 경로 테스트로 실용화","분기 커버리지보다 강함","실행 불가 경로 제외 필요"],"related":["basis-path-testing","cyclomatic-complexity","code-coverage"]},
 {"id":"peer-review","term":"동료검토","term_en":"Peer Review","definition":"작성자의 동료가 산출물을 검토하여 결함을 조기에 발견하고 품질을 높이는 정적 검증 활동의 총칭.","features":["인스펙션·워크스루·패스어라운드 등 형식","테스트 전 결함 제거로 비용 절감","CMMI 검증(VER) 프로세스 영역 요구","비난 아닌 산출물 중심"],"related":["fagan-inspection","code-review","checklist","moderator"]},
 {"id":"pmbok","term":"PMBOK","term_en":"Project Management Body of Knowledge","definition":"PMI가 발간하는 프로젝트 관리 지식 체계 가이드로, 지식 영역·프로세스 그룹(6판) 및 원칙·성과 영역(7판)을 정의.","features":["자원관리에서 팀 개발·터크만 모델 참조","일정관리에 CPM·CCPM 포함","전 세계 PM 표준 참조","7판은 원칙 기반으로 전환"],"related":["team-development","critical-path-method","leadership"]},
 {"id":"priority-queue","term":"우선순위 큐","term_en":"Priority Queue","definition":"각 원소에 우선순위를 두어 우선순위가 가장 높은 원소가 먼저 나가는 큐의 변형.","features":["힙으로 구현 시 삽입·삭제 O(log n)","스케줄링·다익스트라 알고리즘에 활용","FIFO 순서 대신 우선순위 순서","최소·최대 힙 선택"],"related":["deque","fifo","circular-queue"]},
 {"id":"process-asset-library","term":"프로세스 자산 라이브러리","term_en":"Process Asset Library (PAL)","definition":"조직 표준 프로세스·템플릿·사례·교훈 등 프로세스 자산을 저장하고 공유하는 저장소.","features":["CMMI OPD 산출물","프로젝트가 검색·활용·기여","버전 관리와 접근 통제","조직 학습의 기반"],"related":["organizational-process-assets","organizational-standard-process","cmmi"]},
 {"id":"process-capability-index","term":"공정능력지수","term_en":"Process Capability Index (Cp, Cpk)","definition":"프로세스의 산포가 규격 한계를 충족하는 능력을 나타내는 지수로, Cp=(USL-LSL)/6σ, Cpk는 중심 치우침을 반영.","features":["Cp≥1.33이면 양호","Cpk<Cp는 중심 이탈 의미","관리 상태 확인 후 산출","식스시그마 수준 평가와 연계"],"related":["control-chart","six-sigma","histogram"]},
 {"id":"process-tailoring","term":"프로세스 테일러링","term_en":"Process Tailoring","definition":"조직 표준 프로세스를 프로젝트 규모·위험·도메인 특성에 맞게 조정하여 프로젝트 정의 프로세스를 만드는 활동.","features":["테일러링 가이드라인에 따라 수행","필수·선택 요소 구분과 승인","과도한 생략 방지","CMMI IPM의 첫 실천"],"related":["organizational-standard-process","organizational-process-assets","cmmi"]},
 {"id":"product-owner","term":"프로덕트 오너","term_en":"Product Owner","definition":"스크럼에서 제품 백로그의 우선순위를 결정하고 제품 가치를 극대화할 책임을 지는 역할.","features":["백로그 관리와 인수 기준 정의","이해관계자와 팀 사이 단일 창구","스프린트 리뷰에서 증분 승인","칸반에서는 우선순위 책임 명시로 차용"],"related":["scrum","scrum-master","sprint"]},
 {"id":"project-buffer","term":"프로젝트 버퍼","term_en":"Project Buffer","definition":"CCPM에서 크리티컬 체인 끝에 두는 공통 시간 여유로, 작업별로 제거한 안전 여유를 모아 납기를 보호.","features":["제거 여유의 약 50% 또는 체인의 1/3~1/2","소진율을 녹·황·적 3구간으로 관리","작업별 여유보다 효율적 보호","진척 측정 기준"],"related":["critical-chain","feeding-buffer","resource-buffer","theory-of-constraints"]},
 {"id":"pull-system","term":"풀 시스템","term_en":"Pull System","definition":"후속 공정이 필요할 때 선행 공정에서 작업을 가져가는 방식으로, 수요 기반으로 작업을 투입하여 과잉 생산과 WIP를 억제.","features":["도요타 간판 시스템에서 유래","칸반의 WIP 여유 시 카드 당김","푸시 방식의 과부하 방지","린 생산의 핵심 원리"],"related":["kanban-board","work-in-progress-limit","lean"]},
 {"id":"red-green-refactor","term":"Red-Green-Refactor","term_en":"Red-Green-Refactor Cycle","definition":"TDD의 기본 사이클로, 실패하는 테스트 작성(Red), 통과하는 최소 구현(Green), 설계 개선(Refactor)을 반복.","features":["수 분 단위의 짧은 주기","Green에서는 단순 구현 허용","Refactor는 테스트 통과 유지하며 수행","작업 목록으로 다음 사이클 관리"],"related":["test-driven-development","refactoring","unit-testing"]},
 {"id":"refactoring","term":"리팩토링","term_en":"Refactoring","definition":"외부 동작을 바꾸지 않으면서 내부 구조를 개선하여 가독성·유지보수성을 높이는 코드 변경 활동.","features":["테스트로 동작 보존 확인","메서드 추출·이동·이름 변경 등 카탈로그","코드 냄새 제거","TDD 사이클의 세 번째 단계"],"related":["test-driven-development","red-green-refactor","cyclomatic-complexity"]},
 {"id":"region-code","term":"영역 코드","term_en":"Region Code (Outcode)","definition":"코헨-서덜랜드 알고리즘에서 점의 위치를 클리핑 윈도우 기준 상·하·우·좌 4비트로 부호화한 코드.","features":["윈도우 내부는 0000","OR=0이면 완전 수용","AND≠0이면 완전 기각","1인 비트가 교점 계산할 경계 지시"],"related":["line-clipping","clipping-window","computer-graphics"]},
 {"id":"regression-testing","term":"회귀 테스트","term_en":"Regression Testing","definition":"코드 변경 후 기존 기능이 여전히 정상 동작하는지 확인하기 위해 이전 테스트를 재실행하는 테스트.","features":["변경 영향 범위 기반 선택 가능","자동화와 CI 연계 필수","통합 단계마다 누적 수행","테스트 자산 유지보수 필요"],"related":["unit-testing","integration-testing","ci-cd-pipeline","test-harness"]},
 {"id":"resilience","term":"회복탄력성","term_en":"Resilience","definition":"시스템이 장애나 예기치 못한 조건에서도 핵심 기능을 유지하고 신속히 정상 상태로 복구하는 능력.","features":["서킷 브레이커·재시도·격리 등 패턴","카오스 엔지니어링으로 실증","가용성과 구분되는 복구 중심 개념","분산 시스템 설계 핵심 품질"],"related":["chaos-engineering","circuit-breaker","fault-injection"]},
 {"id":"resource-buffer","term":"자원 버퍼","term_en":"Resource Buffer","definition":"CCPM에서 크리티컬 체인 작업에 필요한 핵심 자원이 적시에 투입되도록 사전에 알리는 경보성 버퍼.","features":["시간 여유가 아닌 알림 장치","자원 준비 지연 방지","체인 작업 착수 전 통보","다중 프로젝트에서 중요"],"related":["critical-chain","project-buffer","feeding-buffer"]},
 {"id":"retrospective","term":"회고","term_en":"Retrospective","definition":"스프린트 종료 시 팀이 프로세스와 협업을 돌아보고 개선 사항을 도출하는 스크럼 이벤트.","features":["잘된 점·개선점·실행 항목 도출","지속적 프로세스 개선","칸반에 차용 가능한 케이던스","안전한 분위기가 전제"],"related":["scrum","sprint","scrumban"]},
 {"id":"reusability","term":"재사용성","term_en":"Reusability","definition":"SW 구성요소를 다른 시스템이나 상황에서 수정 없이 또는 최소 수정으로 다시 사용할 수 있는 정도.","features":["컴포넌트·라이브러리·패턴 수준 재사용","높은 응집도·낮은 결합도가 전제","개발 생산성·품질 향상","CBD의 핵심 목표"],"related":["software-component","component-based-development","cohesion"]},
 {"id":"sandwich-integration","term":"샌드위치 통합","term_en":"Sandwich Integration","definition":"상위 계층은 하향식, 하위 계층은 상향식으로 동시에 통합하여 중간 목표 계층에서 만나는 혼합 통합 방식.","features":["하향식·상향식 장점 결합","드라이버와 스텁 모두 필요","대규모 시스템에 적합","중간 계층 테스트 집중"],"related":["top-down-integration","bottom-up-integration","integration-testing"]},
 {"id":"scatter-diagram","term":"산점도","term_en":"Scatter Diagram","definition":"두 변수의 데이터를 좌표 평면에 점으로 표시하여 상관관계를 파악하는 QC 도구.","features":["양·음·무상관 판단","복잡도와 결함 수 관계 분석","원인-결과 가설 검증","회귀 분석의 사전 탐색"],"related":["seven-qc-tools","histogram","control-chart"]},
 {"id":"scrum","term":"스크럼","term_en":"Scrum","definition":"고정 길이 스프린트로 증분을 전달하며 PO·스크럼 마스터·개발팀 역할과 계획·일일 스크럼·리뷰·회고 이벤트로 운영되는 애자일 프레임워크.","features":["1~4주 타임박스 스프린트","제품·스프린트 백로그","속도·번다운으로 진척 관리","칸반과 결합한 스크럼반 가능"],"related":["sprint","product-owner","scrum-master","kanban-board","agile"]},
 {"id":"scrum-master","term":"스크럼 마스터","term_en":"Scrum Master","definition":"스크럼 프로세스가 올바르게 적용되도록 팀을 코칭하고 장애물을 제거하는 서번트 리더 역할.","features":["프로세스 촉진자, 관리자가 아님","팀의 자기조직화 지원","외부 간섭으로부터 팀 보호","이벤트 진행 지원"],"related":["scrum","product-owner","sprint"]},
 {"id":"scrumban","term":"스크럼반","term_en":"Scrumban","definition":"스크럼의 역할·이벤트와 칸반의 WIP 제한·풀·흐름 지표를 결합한 하이브리드 애자일 방법.","features":["스프린트 계획을 필요 시 보충 계획으로 대체","WIP 제한으로 흐름 평준화","유지보수·운영 팀 전환에 적합","리뷰·회고 케이던스 유지"],"related":["scrum","kanban-board","work-in-progress-limit","retrospective"]},
 {"id":"seven-qc-tools","term":"QC 7가지 도구","term_en":"Seven Basic Tools of Quality","definition":"품질 문제를 분석·개선하기 위한 기본 통계 도구 묶음으로 관리도·히스토그램·파레토도·특성요인도·체크시트·산점도·층별(또는 흐름도)로 구성.","features":["현장 적용이 쉬운 통계 도구","SPC 절차의 원인 분석에 활용","데이터 기반 의사결정","식스시그마 DMAIC에서도 사용"],"related":["control-chart","pareto-chart","histogram","cause-and-effect-diagram","check-sheet","scatter-diagram"]},
 {"id":"site-reliability-engineering","term":"SRE","term_en":"Site Reliability Engineering","definition":"Google이 정립한 운영 접근법으로, SW 엔지니어링 기법을 운영에 적용하여 SLO 기반으로 신뢰성을 관리.","features":["SLI·SLO·오류 예산","토일 자동화","카오스 실험·게임데이 수행","무비난 사후 분석"],"related":["devops","chaos-engineering","game-day","observability"]},
 {"id":"situational-leadership","term":"상황적 리더십","term_en":"Situational Leadership","definition":"Hersey와 Blanchard가 제안한 이론으로, 구성원의 성숙도에 따라 지시·코칭·지원·위임 스타일을 선택하는 리더십.","features":["과업 행동과 관계 행동의 조합","터크만 단계별 스타일 매핑","구성원 역량·의지 진단","유연한 스타일 전환"],"related":["leadership","team-development","conflict-management"]},
 {"id":"six-sigma","term":"식스시그마","term_en":"Six Sigma","definition":"프로세스 변동을 줄여 백만 기회당 3.4개 결함 수준을 목표로 하는 데이터 기반 품질 경영 기법.","features":["DMAIC(정의·측정·분석·개선·통제) 절차","SPC·관리도를 통제 단계에 활용","벨트 체계의 전문가 양성","공정능력지수로 수준 평가"],"related":["control-chart","process-capability-index","seven-qc-tools","pdca"]},
 {"id":"software-component","term":"컴포넌트","term_en":"Software Component","definition":"명세된 인터페이스를 통해서만 접근되고 구현이 캡슐화된, 독립 배포·교체·재사용이 가능한 SW 단위.","features":["제공·요구 인터페이스 계약","바이너리 수준 블랙박스 재사용","컨테이너가 생명주기 관리","모듈의 상위 개념"],"related":["component-based-development","interface","module","encapsulation","reusability"]},
 {"id":"special-cause-variation","term":"이상 원인 변동","term_en":"Special Cause Variation","definition":"프로세스 외부의 특정 요인으로 발생하는 비무작위 변동으로, 관리도에서 한계 이탈이나 패턴으로 나타나며 식별·제거 대상.","features":["관리 한계 이탈·런 규칙 위반으로 탐지","특성요인도로 원인 분석","제거 후 관리 상태 복귀","우연 원인과 구분 필수"],"related":["common-cause-variation","control-chart","cause-and-effect-diagram"]},
 {"id":"sprint","term":"스프린트","term_en":"Sprint","definition":"스크럼에서 잠재적으로 출시 가능한 증분을 만드는 1~4주의 고정 길이 반복 주기.","features":["스프린트 중 범위 변경 금지","계획·일일 스크럼·리뷰·회고 포함","속도로 처리 용량 측정","칸반은 고정 주기 없음"],"related":["scrum","velocity","burndown-chart","retrospective"]},
 {"id":"stakeholder","term":"이해관계자","term_en":"Stakeholder","definition":"프로젝트 결과에 영향을 주거나 받는 개인·집단·조직으로, 고객·사용자·스폰서·팀·협력업체 등을 포함.","features":["식별·참여 계획·관리 필요","CMMI IPM에서 참여·의존성 조정","기대 관리가 성공 요인","권력·관심 격자로 분류"],"related":["organizational-standard-process","cmmi","pmbok"]},
 {"id":"statement-coverage","term":"구문 커버리지","term_en":"Statement Coverage","definition":"프로그램의 모든 실행 가능한 문장이 최소 1회 실행되었는지 측정하는 가장 기본적인 코드 커버리지.","features":["라인 커버리지라고도 함","분기 누락 가능한 약한 기준","DO-178C Level C, ASIL A 요구","도달 불가 코드 식별"],"related":["branch-coverage","code-coverage","white-box-testing"]},
 {"id":"student-syndrome","term":"학생 증후군","term_en":"Student Syndrome","definition":"마감이 임박해서야 작업에 착수하여 작업별 안전 여유를 초반에 소진하는 행동 현상.","features":["작업별 여유의 무력화","CCPM이 여유를 버퍼로 집중하여 대응","파킨슨 법칙과 함께 지연 원인","가능한 늦게 착수하되 집중 수행으로 극복"],"related":["parkinsons-law","critical-chain","project-buffer"]},
 {"id":"sutherland-hodgman-algorithm","term":"Sutherland-Hodgman 알고리즘","term_en":"Sutherland-Hodgman Polygon Clipping Algorithm","definition":"다각형의 정점 리스트를 클리핑 윈도우의 각 경계에 대해 순차적으로 클리핑하여 내부 다각형을 생성하는 알고리즘.","features":["경계마다 정점 입력·출력 규칙 4가지","볼록 클리핑 영역에 적합","오목 다각형은 불필요 간선 발생 가능","선분 클리핑과 구분"],"related":["line-clipping","clipping-window","liang-barsky-algorithm"]},
 {"id":"team-building","term":"팀 빌딩","term_en":"Team Building","definition":"팀 구성원 간 신뢰·협력·결속을 높이기 위해 수행하는 활동으로, 팀 발달 단계를 가속하는 수단.","features":["킥오프·워크숍·공동 목표 설정","혼돈 단계 단축에 효과","가상 팀에 의도적 설계 필요","PMBOK 팀 개발 기법"],"related":["team-development","leadership","conflict-management"]},
 {"id":"team-development","term":"팀 발달","term_en":"Team Development","definition":"팀이 구성된 후 상호작용을 통해 성숙한 고성과 팀으로 변화해 가는 과정으로, 터크만 모델이 대표적 설명.","features":["형성·혼돈·규범·성과·해체 단계","단계별 리더십 전환","구성원 변경 시 퇴행 가능","PMBOK 자원관리의 팀 개발 프로세스"],"related":["leadership","situational-leadership","team-building","conflict-management"]},
 {"id":"test-case","term":"테스트 케이스","term_en":"Test Case","definition":"특정 요구사항 검증을 위해 사전 조건·입력값·실행 절차·기대 결과·사후 조건을 명세한 테스트 실행 단위.","features":["요구사항 추적성 확보","설계 기법으로 최소 집합 선정","재현 가능한 검증","회귀 테스트 자산"],"related":["expected-result","test-plan","test-oracle","black-box-testing","white-box-testing"]},
 {"id":"test-driven-development","term":"테스트 주도 개발","term_en":"Test-Driven Development (TDD)","definition":"실패하는 단위 테스트를 먼저 작성하고 통과할 최소 코드를 구현한 뒤 리팩토링하는 사이클을 반복하는 개발 기법.","features":["Red-Green-Refactor 사이클","테스트가 명세·설계 역할","결합도 낮은 설계 유도","XP 핵심 실천법"],"related":["red-green-refactor","unit-testing","refactoring","xunit","mock-object"]},
 {"id":"test-driver","term":"테스트 드라이버","term_en":"Test Driver","definition":"테스트 대상 모듈을 호출하는 상위 모듈을 대신하여 입력을 전달하고 결과를 수집·검증하는 임시 제어 프로그램.","features":["상향식 통합 테스트에서 사용","xUnit 테스트 러너가 역할 수행","테스트 하네스 구성요소","스텁과 반대 방향"],"related":["test-stub","bottom-up-integration","test-harness","unit-testing","xunit"]},
 {"id":"test-harness","term":"테스트 하네스","term_en":"Test Harness","definition":"테스트 드라이버·스텁·테스트 데이터·실행 엔진·비교·보고 기능을 통합하여 테스트를 자동 실행하는 환경.","features":["미완성 모듈 환경에서 테스트 가능","회귀 테스트 자동화","격리로 결함 원인 국소화","xUnit·임베디드 HIL 등 형태"],"related":["test-driver","test-stub","mock-object","xunit","regression-testing"]},
 {"id":"test-oracle","term":"테스트 오라클","term_en":"Test Oracle","definition":"테스트 실행 결과의 합격·불합격을 판정하기 위해 기대 결과를 제공하거나 비교하는 정보원·메커니즘.","features":["참·샘플링·휴리스틱·일관성 유형","명세·수식·레거시·전문가가 정보원","자동화 판정의 핵심","오라클 문제 영역은 메타모픽 테스트로 보완"],"related":["expected-result","heuristic-oracle","test-oracle-problem","metamorphic-testing","test-case"]},
 {"id":"test-oracle-problem","term":"테스트 오라클 문제","term_en":"Test Oracle Problem","definition":"과학 계산·기계학습·시뮬레이션 등에서 주어진 입력의 올바른 출력을 사전에 알 수 없어 테스트 판정이 곤란한 문제.","features":["참 오라클 구축 불가","메타모픽·일관성·속성 기반 테스트로 대응","자동 테스트 생성의 병목","AI 시스템 검증의 핵심 과제"],"related":["test-oracle","metamorphic-testing","heuristic-oracle"]},
 {"id":"test-plan","term":"테스트 계획","term_en":"Test Plan","definition":"테스트의 목적·범위·전략·환경·자원·일정·완료 기준·산출물을 정의한 문서로, IEEE 829·ISO/IEC/IEEE 29119 양식 참조.","features":["테스트 활동의 기준선","위험 기반 우선순위 반영","완료 기준으로 종료 판단","케이스 설계의 상위 문서"],"related":["test-case","expected-result","black-box-testing"]},
 {"id":"test-stub","term":"테스트 스텁","term_en":"Test Stub","definition":"테스트 대상이 호출하는 하위 모듈을 대신하여 고정된 단순 응답을 반환하는 임시 더미 모듈.","features":["하향식 통합 테스트에서 사용","구현 단순, 모듈마다 필요","목 객체보다 검증 기능 적음","드라이버와 반대 방향"],"related":["test-driver","top-down-integration","mock-object","test-harness"]},
 {"id":"theory-of-constraints","term":"제약이론","term_en":"Theory of Constraints (TOC)","definition":"Goldratt가 제안한 경영 이론으로, 시스템 성과를 제한하는 제약을 식별·집중 관리하여 전체 처리량을 극대화.","features":["집중 5단계: 식별·활용·종속·향상·반복","드럼-버퍼-로프 생산 통제","CCPM으로 프로젝트 일정에 적용","전체 최적화 사고"],"related":["critical-chain","drum-buffer-rope","project-buffer","critical-path-method"]},
 {"id":"top-down-integration","term":"하향식 통합 테스트","term_en":"Top-Down Integration Testing","definition":"최상위 제어 모듈부터 깊이 우선 또는 너비 우선으로 하위 모듈을 결합해 내려가는 점진적 통합 방식.","features":["하위 모듈 대체용 스텁 필요","주요 제어·설계 결함 조기 발견","초기 프로토타입 시연 가능","하위 기능 검증 지연"],"related":["integration-testing","test-stub","bottom-up-integration","sandwich-integration"]},
 {"id":"unit-testing","term":"단위 테스트","term_en":"Unit Testing","definition":"함수·클래스·모듈 등 가장 작은 테스트 가능 단위를 독립적으로 검증하는 테스트 단계.","features":["xUnit 프레임워크로 자동화","드라이버·스텁·목으로 격리","TDD의 기본 단위","코드 커버리지 측정 대상"],"related":["xunit","mock-object","test-driven-development","integration-testing","code-coverage"]},
 {"id":"usability-testing","term":"사용성 테스트","term_en":"Usability Testing","definition":"실제 사용자가 과업을 수행하는 과정을 관찰하여 UI의 효과성·효율성·만족도를 평가하는 테스트.","features":["과업 완료율·소요 시간·오류 측정","실사용자 관점 문제 발견","크라우드소싱·원격 테스트 가능","설문·인터뷰 병행"],"related":["crowdsourcing","beta-testing","exploratory-testing"]},
 {"id":"use-case","term":"유스케이스","term_en":"Use Case","definition":"액터가 시스템을 통해 목표를 달성하는 상호작용 시나리오를 기술한 기능 요구사항 단위.","features":["액터·사전조건·기본·대안 흐름 구성","유스케이스 다이어그램으로 표현","프로세스 컴포넌트 식별 기준","테스트 시나리오 도출 원천"],"related":["class-diagram","component-based-development","software-component"]},
 {"id":"velocity","term":"속도","term_en":"Velocity","definition":"스크럼 팀이 한 스프린트에 완료한 작업량(스토리 포인트)의 합으로, 향후 처리 용량 예측에 사용.","features":["팀 고유 상대 지표","스프린트 계획 범위 산정","팀 간 비교 부적절","칸반은 처리량·리드타임 사용"],"related":["scrum","sprint","burndown-chart","lead-time"]},
 {"id":"viewport","term":"뷰포트","term_en":"Viewport","definition":"클리핑 윈도우의 내용이 실제로 표시되는 화면(장치 좌표)상의 직사각형 영역.","features":["윈도우-뷰포트 변환으로 매핑","종횡비 불일치 시 왜곡","클리핑 후 변환 수행","다중 뷰포트로 화면 분할"],"related":["clipping-window","computer-graphics","line-clipping"]},
 {"id":"work-in-progress-limit","term":"WIP 제한","term_en":"Work-In-Progress Limit","definition":"칸반에서 각 작업 단계에 동시에 존재할 수 있는 작업 항목 수의 상한.","features":["멀티태스킹 억제, 완료 우선","병목을 즉시 노출","리틀의 법칙으로 초기값 산정","풀 시스템 작동의 전제"],"related":["kanban-board","pull-system","lead-time","cycle-time","cumulative-flow-diagram"]},
 {"id":"xunit","term":"xUnit","term_en":"xUnit Test Framework","definition":"JUnit·NUnit·pytest 등 단위 테스트 프레임워크 계열의 총칭으로, 테스트 케이스·픽스처·러너·단언 구조를 공통으로 제공.","features":["테스트 드라이버·하네스 역할 자동화","셋업·티어다운 픽스처","assert 기반 자동 판정","CI 연계 리포트 출력"],"related":["unit-testing","test-driver","test-harness","test-driven-development","ci-cd-pipeline"]}
]
